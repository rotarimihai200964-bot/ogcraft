# Copiază fișierul ca .env și completează valorile
DISCORD_TOKEN=tokenul_botului_tau
CLIENT_ID=application_id_din_developer_portal
# Opțional: ID-ul serverului tău de Discord (comenzile apar instant)
GUILD_ID=
# IP-ul serverului de Minecraft (pentru /status și /ip)
MC_SERVER=mc.ogcraft-rpg.com

# /ai: cheie API de pe platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# AI_MODEL=claude-haiku-5-5

# Anti-spam (ANTISPAM=false îl oprește și nu mai cere Message Content Intent)
ANTISPAM=true
# SPAM_MAX_MESSAGES=5
# SPAM_WINDOW_SEC=5
# SPAM_MAX_DUPLICATES=3
# SPAM_MAX_MENTIONS=5
# SPAM_BLOCK_INVITES=true
# SPAM_TIMEOUT_MIN=5
# LOG_CHANNEL_ID=
